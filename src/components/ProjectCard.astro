---
interface Props {
  project: {
    name: string;
    description: string;
    technologies: string[];
    image?: string;
    imageAlt?: string;
    link?: string;
  };
}

const { project } = Astro.props;
---
<article>
  {project.image && (
    <img
      src={project.image}
      alt={project.imageAlt ?? project.name}
      loading="lazy"
      decoding="async"
    />
  )}
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <ul>
    {project.technologies.map((technology) => (
      <li><span class="tech-chip">{technology}</span></li>
    ))}
  </ul>
  {project.link && <a href={project.link}>{project.name}</a>}
</article>
