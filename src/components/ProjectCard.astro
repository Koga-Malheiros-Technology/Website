---
import Icon from './Icon.astro';

interface Props {
  project: {
    name: string;
    description: string;
    technologies: string[];
    image?: string;
    imageAlt?: string;
    imageIcon?: boolean;
    link?: string;
    linkLabel?: string;
  };
}

const { project } = Astro.props;
---
<article class="project-card">
  <div class="project-media">
    {project.image ? (
      <img
        src={project.image}
        alt={project.imageAlt ?? project.name}
        class:list={project.imageIcon ? 'project-icon' : 'project-image'}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Icon name="mark" />
    )}
  </div>
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <ul>
    {project.technologies.map((technology) => (
      <li><span class="tech-chip">{technology}</span></li>
    ))}
  </ul>
  {project.link && (
    <a class="project-access" href={project.link} aria-label={`${project.linkLabel ?? 'Acessar sistema'}: ${project.name}`}>
      {project.linkLabel ?? 'Acessar sistema'}
      <Icon name="arrow-right" />
    </a>
  )}
</article>
