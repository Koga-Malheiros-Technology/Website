---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ValueCard from '../components/ValueCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <h1>{site.company.name}</h1>
  <SectionHeading id="sobre" title="Sobre a empresa">
    <p>{site.company.about}</p>
  </SectionHeading>
  <SectionHeading id="valores" title="Valores">
    <ul>
      {site.values.map((value) => (
        <li><ValueCard value={value} /></li>
      ))}
    </ul>
  </SectionHeading>
  <SectionHeading id="servicos" title="Serviços de tecnologia">
    <ul>
      {site.services.map((service) => (
        <li><ServiceCard service={service} /></li>
      ))}
    </ul>
  </SectionHeading>
  {site.projects.length > 0 && (
    <SectionHeading id="sistemas" title="Sistemas já desenvolvidos">
      <ul>
        {site.projects.map((project) => (
          <li><ProjectCard project={project} /></li>
        ))}
      </ul>
    </SectionHeading>
  )}
  <ContactSection />
</BaseLayout>
