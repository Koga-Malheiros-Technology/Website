---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ValueCard from '../components/ValueCard.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <h1>KM Technology</h1>
  <SectionHeading id="sobre" title="Sobre a empresa">
    <p>{site.company.about}</p>
  </SectionHeading>
  <SectionHeading id="valores" title="Valores">
    <ul>
      {site.values.map((value) => (
        <li><ValueCard value={value} /></li>
      ))}
    </ul>
  </SectionHeading>
</BaseLayout>
